// Aumveda — Canonical Prisma Schema
// DB: PostgreSQL (Supabase / Neon.tech)

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooler (port 6543)
  directUrl = env("DIRECT_URL")   // direct (port 5432)
}

/// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum CourseLevel {
  ALL_LEVELS
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentGateway {
  CASHFREE
  RAZORPAY
  EAZEBUS
  EASEBUZZ
  EASEBUZZ_PRIMARY
  EASEBUZZ_SECONDARY
}

enum ServiceType {
  ASTROLOGY_ARCHANA
  SOMATIC_SEJAL
  DUAL_SYNERGY
  MENTORSHIP_INTENSIVE
  VASTU_CONSULTATION
  DISCOVERY_CALL
}

enum BookingStatus {
  SCHEDULED
  COMPLETED
  RESCHEDULED
  CANCELLED
  NO_SHOW
}

// ─────────────────────────────────────────────────────────────
// AUTH & USER IDENTITY (NextAuth + Supabase Integration)
// ─────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  phone         String?
  image         String?
  passwordHash  String?   @db.Text
  googleId      String?   @unique
  role          String    @default("user") // "user" | "client" | "practitioner" | "admin" | "super_admin"

  // Auth extensions & OTP
  otpCode                  String?
  otpExpires               DateTime?
  resetToken               String?
  resetTokenExpires        DateTime?
  verificationToken        String?
  verificationTokenExpires DateTime?

  // Birth chart & Vedic Astrology metadata
  dob            DateTime?
  birthLat       Float?
  birthLng       Float?
  placeOfBirth   String?
  timeOfBirth    String?
  risingSign     String?
  sunSign        String?
  moonSign       String?
  dominantChakra String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NextAuth relations
  accounts Account[]
  sessions Session[]

  // Core profile & health
  profile              Profile?
  practitionerProfile  PractitionerProfile?
  journals             Journal[]
  orders               Order[]
  achievements         Achievement[]
  consents             Consent[]
  healthSyncs          HealthSync[]
  healthMetrics        HealthMetric[]
  dailyDoseCompletions DailyDoseCompletion[]
  progressSnapshots    ProgressSnapshot[]
  events               Event[]

  // LMS Academy relations
  enrollments       CourseEnrollment[]
  lessonProgress    LessonProgress[]
  lessonReflections LessonReflection[]
  quizSubmissions   QuizSubmission[]
  certificates      CourseCertificate[]
  reviews           CourseReview[]

  // Portal & Services
  dailyDoseOverrides      DailyDoseOverride[]
  dailyDoseDeliveries     DailyDoseDelivery[]
  portalData              UserPortalData?
  bookings                Booking[]
  therapySessions         TherapySession[]
  packages                Package[]
  communityMember         CommunityMember?
  subscription            Subscription?
  liveCircleRSVPs         LiveCircleRSVP[]
  challengeParticipations ChallengeParticipation[]
  contentViews            ContentView[]
  dailyCheckIns           DailyCheckIn[]
  clientHomework          ClientHomework[]
  serviceBookings         ServiceBooking[]
  preSessionBriefs        PreSessionBrief[]
  circleMemberships       CircleMember[]
  circlePosts             CirclePost[]
  circleComments          CircleComment[]

  @@map("users")
}

model Profile {
  id             Int      @id @default(autoincrement())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  timezone       String   @default("Asia/Kolkata")
  avatarUrl      String?
  bio            String?  @db.Text
  progress       Float    @default(0) // latest P_t value 0–100
  streakDays     Int      @default(0)
  onboardingDone Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("profiles")
}

// ─────────────────────────────────────────────────────────────
// LMS & YOUTUBE ACADEMY ENGINE
// ─────────────────────────────────────────────────────────────

model Course {
  id                   String             @id @default(cuid())
  slug                 String             @unique
  title                String
  subtitle             String?
  description          String             @db.Text
  thumbnailUrl         String?
  thumbnailKey         String?            // R2 key fallback
  trailerYoutubeId     String?
  instructorName       String             @default("Archana & Sejal Jain")
  level                CourseLevel        @default(ALL_LEVELS)
  priceINR             Decimal            @default(0.00) @db.Decimal(10, 2)
  salePriceINR         Decimal?           @db.Decimal(10, 2)
  isPaid               Boolean            @default(false)
  priceCents           Int?               // legacy paise support
  isPublished          Boolean            @default(false)
  totalDurationMinutes Int                @default(0)
  certificateEnabled   Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  modules      CourseModule[]
  enrollments  CourseEnrollment[]
  certificates CourseCertificate[]
  reviews      CourseReview[]

  @@map("courses")
}

model CourseModule {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?  @db.Text
  sortOrder   Int      @default(1)
  orderIndex  Int?     @default(1) // compatibility
  durationSec Int?
  isPreview   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons CourseLesson[]
  quizzes CourseQuiz[]

  @@index([courseId, sortOrder])
  @@map("course_modules")
}

model CourseLesson {
  id               String   @id @default(cuid())
  moduleId         String
  title            String
  description      String?  @db.Text
  youtubeVideoId   String   // Unlisted YouTube Video ID
  durationSeconds  Int      @default(0)
  sortOrder        Int      @default(1)
  isFreePreview    Boolean  @default(false)
  workbookPdfUrl   String?
  audioDownloadUrl String?
  reflectionPrompt String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  module          CourseModule       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progressRecords LessonProgress[]
  reflections     LessonReflection[]

  @@index([moduleId, sortOrder])
  @@map("course_lessons")
}

model LessonReflection {
  id             String       @id @default(cuid())
  userId         String
  lessonId       String
  reflectionText String       @db.Text
  mood           Int?         // 1 to 5
  isPrivate      Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("lesson_reflections")
}

model LessonProgress {
  id                    String    @id @default(cuid())
  userId                String
  lessonId              String
  watchTimeSeconds      Int       @default(0)
  maxWatchTimeSeconds   Int       @default(0)
  isCompleted           Boolean   @default(false)
  completedAt           DateTime?
  lastPlayedPositionSec Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, isCompleted])
  @@map("lesson_progress")
}

model CourseEnrollment {
  id          String           @id @default(cuid())
  userId      String
  courseId    String
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?
  orderId     String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId, status])
  @@map("course_enrollments")
}

model CourseQuiz {
  id              String   @id @default(cuid())
  moduleId        String
  title           String
  passingScorePct Int      @default(80)
  questionsJson   Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  module      CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  submissions QuizSubmission[]

  @@index([moduleId])
  @@map("course_quizzes")
}

model QuizSubmission {
  id                   String   @id @default(cuid())
  userId               String
  quizId               String
  scorePct             Int
  isPassed             Boolean  @default(false)
  submittedAnswersJson Json
  submittedAt          DateTime @default(now())

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz CourseQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId, quizId])
  @@map("quiz_submissions")
}

model CourseCertificate {
  id                String   @id @default(cuid())
  certificateNumber String   @unique
  userId            String
  courseId          String
  issuedAt          DateTime @default(now())
  pdfUrl            String
  verificationHash  String   @unique

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("course_certificates")
}

model CourseReview {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  rating     Int      // 1 to 5
  reviewText String?  @db.Text
  isFeatured Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("course_reviews")
}

// ─────────────────────────────────────────────────────────────
// E-COMMERCE & CRYSTAL SANCTUARY
// ─────────────────────────────────────────────────────────────

model Product {
  id                   Int      @id @default(autoincrement())
  sku                  String   @unique
  slug                 String   @unique
  title                String
  name                 String?  // alias for title
  shortDescription     String?  @db.Text
  description          String   @db.Text
  category             String   @default("Crystals")
  chakraAffinity       String?  // "Root", "Heart", "Third Eye", etc.
  chakraAssociation    String?  // legacy alias
  planetaryRuler       String?  // "Saturn", "Venus", "Moon", etc.
  originCountry        String   @default("India")
  priceINR             Decimal  @default(0.00) @db.Decimal(10, 2)
  salePriceINR         Decimal? @db.Decimal(10, 2)
  priceCents           Int      // stored in paise
  compareAtPriceCents  Int?     // MRP in paise
  currency             String   @default("INR")
  images               String[] // R2 keys or URLs
  stockQuantity        Int      @default(100)
  inventoryCount       Int      @default(100)
  weightGrams          Int?
  dimensionsCm         String?
  activationRitualText String?  @db.Text
  isActive             Boolean  @default(true)
  isPublished          Boolean  @default(true)
  productType          String   @default("physical")
  referenceId          Int?
  tags                 String[]
  metadata             Json?
  healingProperties    Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  orderItems OrderItem[]

  @@map("products")
}

model Order {
  id                  Int             @id @default(autoincrement())
  orderNumber         String?         @unique
  userId              String?
  status              String          @default("PENDING")
  paymentStatus       String          @default("PENDING")
  totalAmountINR      Decimal?        @db.Decimal(10, 2)
  discountAmountINR   Decimal?        @default(0.00) @db.Decimal(10, 2)
  shippingAmountINR   Decimal?        @default(0.00) @db.Decimal(10, 2)
  taxAmountINR        Decimal?        @default(0.00) @db.Decimal(10, 2)
  gstBreakdown        Json?
  totalCents          Int             // stored in paise
  currency            String          @default("INR")
  paymentGateway      PaymentGateway? @default(EASEBUZZ_PRIMARY)
  gateway             String?         @default("EASEBUZZ_PRIMARY")
  gatewayOrderId      String?         @unique
  gatewayPaymentId    String?
  easebuzzOrderId     String?         @unique
  easebuzzPaymentId   String?
  eazebusOrderId      String?         @unique
  eazebusPaymentId    String?
  paymentMeta         Json?
  shippingAddress     Json?
  billingAddress      Json?
  trackingNumber      String?
  shippingCarrier     String?
  customerEmail       String?
  customerName        String?
  customerPhone       String?
  activationGuideSent Boolean         @default(false)
  preSessionBriefId   String?
  paidAt              DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items OrderItem[]

  @@index([userId, status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id            Int      @id @default(autoincrement())
  orderId       Int
  productId     Int
  courseId      String?
  itemType      String   @default("PRODUCT") // "PRODUCT" | "COURSE" | "SERVICE"
  name          String?
  sku           String?
  title         String?
  unitPriceINR  Decimal? @db.Decimal(10, 2)
  quantity      Int      @default(1)
  totalPriceINR Decimal? @db.Decimal(10, 2)
  priceCents    Int      // in paise

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ─────────────────────────────────────────────────────────────
// 1:1 SERVICES & PRACTITIONERS
// ─────────────────────────────────────────────────────────────

model PractitionerProfile {
  id              String   @id @default(cuid())
  userId          String?  @unique
  slug            String   @unique // "archana-jain", "sejal-jain"
  name            String
  title           String   // "Vedic Astrologer & Vastu Master", "Somatic & Energy Healer"
  bio             String   @db.Text
  avatarUrl       String?
  specialties     String[] // ["Vedic Astrology", "Vastu Shastra", "Somatic Experiencing"]
  languages       String[] @default(["English", "Hindi"])
  experienceYears Int      @default(10)
  hourlyRateINR   Decimal  @default(3500.00) @db.Decimal(10, 2)
  calBookingUrl   String?
  isActive        Boolean  @default(true)
  rating          Float    @default(5.0)
  reviewCount     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  offerings ServiceOffering[]

  @@map("practitioner_profiles")
}

model ServiceOffering {
  id               String      @id @default(cuid())
  slug             String      @unique
  practitionerId   String
  name             String
  headline         String?
  description      String      @db.Text
  serviceType      ServiceType
  durationMinutes  Int         @default(60)
  priceINR         Decimal     @db.Decimal(10, 2)
  salePriceINR     Decimal?    @db.Decimal(10, 2)
  isActive         Boolean     @default(true)
  maxParticipants  Int         @default(1)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  practitioner PractitionerProfile @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  bookings     ServiceBooking[]

  @@index([practitionerId, isActive])
  @@map("service_offerings")
}

model ServiceBooking {
  id                  String           @id @default(cuid())
  bookingReference    String           @unique
  userId              String
  serviceOfferingId   String?
  practitionerName    String           // "Archana Jain", "Sejal Jain", or "Both"
  serviceType         ServiceType
  status              BookingStatus    @default(SCHEDULED)
  scheduledStartTime  DateTime
  scheduledEndTime    DateTime
  meetingUrl          String?
  calEventId          String?
  preSessionBriefJson Json?
  practitionerNotes   String?          @db.Text
  prescriptionJson    Json?
  feeINR              Decimal          @db.Decimal(10, 2)
  orderId             String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceOffering ServiceOffering? @relation(fields: [serviceOfferingId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([scheduledStartTime])
  @@map("service_bookings")
}

// ─────────────────────────────────────────────────────────────
// CONSENT & AUDIT EVENT STREAM
// ─────────────────────────────────────────────────────────────

model Consent {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String   // e.g. "tracking", "health_sync", "marketing", "ai_personalization"
  value     Boolean
  version   String   @default("v1")
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
  @@map("consents")
}

model Event {
  id        Int      @id @default(autoincrement())
  eventId   String   @unique @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventName String   // e.g. "journal.created", "course.enrolled", "purchase"
  payload   Json
  source    String   @default("server") // "client" | "server" | "web" | "mobile"
  forwarded Boolean  @default(false)    // true once dispatched to GTM Server
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([eventName, createdAt])
  @@index([userId, eventName])
  @@map("events")
}

// ─────────────────────────────────────────────────────────────
// JOURNALS, DAILY DOSE & HEALTH
// ─────────────────────────────────────────────────────────────

model Journal {
  id                  Int      @id @default(autoincrement())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title               String?
  body                String   @db.Text
  images              String[]
  voiceNoteUrl        String?
  aiReflection        String?  @db.Text
  practitionerVisible Boolean  @default(true)
  mood                Int?     // 1–5
  tags                String[]
  isDeleted           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId, isDeleted, createdAt])
  @@map("journals")
}

model DailyDose {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String?  @unique
  chakra      String?
  audioKey    String
  audioUrl    String?
  promptText  String   @db.Text
  durationSec Int
  isActive     Boolean   @default(true)
  scheduledFor DateTime?
  publishDate  DateTime  @default(now())
  createdAt   DateTime @default(now())

  completions DailyDoseCompletion[]

  @@map("daily_doses")
}

model DailyDoseCompletion {
  id          Int       @id @default(autoincrement())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  doseId      Int
  dose        DailyDose @relation(fields: [doseId], references: [id])
  completedAt DateTime  @default(now())

  @@unique([userId, doseId])
  @@map("daily_dose_completions")
}

model ProgressSnapshot {
  id             Int      @id @default(autoincrement())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime @db.Date
  score          Float    // overall P_t 0–100
  sleepScore     Float    @default(50)
  activityScore  Float    @default(0)
  journalScore   Float    @default(0)
  wellbeingScore Float    @default(50)
  createdAt      DateTime @default(now())

  @@unique([userId, date])
  @@map("progress_snapshots")
}

model Achievement {
  id       Int      @id @default(autoincrement())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key      String
  metadata Json?
  earnedAt DateTime @default(now())

  @@unique([userId, key])
  @@map("achievements")
}

model HealthSync {
  id                    Int       @id @default(autoincrement())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider              String    // "google-fit" | "health-connect"
  encryptedAccessToken  String?   @db.Text
  encryptedRefreshToken String?   @db.Text
  tokenExpiresAt        DateTime?
  lastSyncAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([userId, provider])
  @@map("health_syncs")
}

model HealthMetric {
  id             Int      @id @default(autoincrement())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  metricDate     DateTime @db.Date
  sleepMinutes   Int?
  sleepScore     Int?
  steps          Int?
  workoutMinutes Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, metricDate])
  @@map("health_metrics")
}

// ─────────────────────────────────────────────────────────────
// PORTAL & ASTROLOGICAL REFERENCE MODELS
// ─────────────────────────────────────────────────────────────

model DailyDoseOverride {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  practiceType    String
  instructionText String   @db.Text
  startsAt        DateTime
  durationDays    Int
  source          String?
  createdAt       DateTime @default(now())

  @@map("daily_dose_overrides")
}

model DailyDoseDelivery {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime  @db.Date
  contentJson    String    @db.Text
  deliveredAt    DateTime?
  openedAt       DateTime?
  completedAt    DateTime?
  channel        String    @default("whatsapp")
  deliveryStatus String    @default("pending")
  failureReason  String?
  overrideSource String?

  @@unique([userId, date])
  @@map("daily_dose_deliveries")
}

model UserPortalData {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chakraSelected     String?
  archetypeSelected  String?
  tarotCard          String?
  tarotTheme         String?
  intentionText      String?   @db.Text
  q1Answer           String?
  q2Answer           String?
  q3Answer           String?
  q4Answer           String?
  q5Answer           String?
  q6Answer           String?
  q7Answer           String?
  nervousSystemScore String?
  relationshipScore  String?
  childhoodScore     String?
  financialScore     String?
  profileResult      String?
  portalCompletedAt  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("user_portal_data")
}

model Booking {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id])
  practitioner      String
  serviceType       String
  bookingDatetime   DateTime
  durationMinutes   Int
  status            String          @default("pending")
  amountPaid        Decimal         @default(0) @db.Decimal(10, 2)
  razorpayPaymentId String?
  zoomLink          String?
  calendlyEventId   String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  therapySession    TherapySession?

  @@map("bookings")
}

model TherapySession {
  id                        String    @id @default(cuid())
  bookingId                 String?   @unique
  booking                   Booking?  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId                    String
  user                      User      @relation(fields: [userId], references: [id])
  practitioner              String
  sessionDate               DateTime
  keyThemes                 String[]
  practicesAssigned         String[]
  nextSessionRecommendation String?   @db.Text
  distressFlag              Boolean   @default(false)
  recordingUrl              String?
  notesSubmittedAt          DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@map("therapy_sessions")
}

model Package {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  packageType   String
  sessionsTotal Int
  sessionsUsed  Int       @default(0)
  amountPaid    Decimal   @db.Decimal(10, 2)
  purchasedAt   DateTime  @default(now())
  expiresAt     DateTime?

  @@map("packages")
}

model CommunityMember {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier                String   @default("free")
  joinedAt            DateTime @default(now())
  lastActiveAt        DateTime @default(now())
  circlesAttended     Int      @default(0)
  challengesCompleted Int      @default(0)

  @@map("community_members")
}

model Subscription {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id])
  plan                   String
  amount                 Decimal  @db.Decimal(10, 2)
  startDate              DateTime @default(now())
  nextBillingDate        DateTime
  razorpaySubscriptionId String?
  status                 String   @default("active")

  @@map("subscriptions")
}

model LiveCircle {
  id                   String           @id @default(cuid())
  host                 String
  topic                String
  scheduledAt          DateTime
  zoomLink             String
  attendeeCount        Int              @default(0)
  recordingUrl         String?
  recordingAvailableAt DateTime?
  createdAt            DateTime         @default(now())
  rsvps                LiveCircleRSVP[]

  @@map("live_circles")
}

model LiveCircleRSVP {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  circleId  String
  circle    LiveCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([userId, circleId])
  @@map("live_circle_rsvps")
}

model Challenge {
  id             String                   @id @default(cuid())
  title          String
  durationDays   Int
  profileTargets String[]
  chakraTargets  String[]
  startDate      DateTime
  createdAt      DateTime                 @default(now())
  participations ChallengeParticipation[]

  @@map("challenges")
}

model ChallengeParticipation {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  challengeId   String
  challenge     Challenge @relation(fields: [challengeId], references: [id])
  enrolledAt    DateTime  @default(now())
  daysCompleted Int       @default(0)
  lastCheckInAt DateTime? @db.Date
  completedAt   DateTime?

  @@unique([userId, challengeId])
  @@map("challenge_participations")
}

model ChakraReveal {
  id          String @id @default(cuid())
  chakraName  String @unique
  heading     String
  sub         String
  blockedText String @db.Text
  showsUpAs   String @db.Text

  @@map("chakra_reveals")
}

model ArchetypeReveal {
  id        String @id @default(cuid())
  name      String @unique
  icon      String
  gift      String @db.Text
  wound     String @db.Text
  showsUpAs String @db.Text

  @@map("archetype_reveals")
}

model TarotTheme {
  id        String   @id @default(cuid())
  themeName String   @unique
  message   String   @db.Text
  cardNames String[]

  @@map("tarot_themes")
}

model ChartPrediction {
  id             String @id @default(cuid())
  placementType  String
  sign           String
  predictionText String @db.Text

  @@unique([placementType, sign])
  @@map("chart_predictions")
}

model PatternQuestion {
  id           String @id @default(cuid())
  questionId   String @unique
  questionText String @db.Text
  dimension    String
  options      Json

  @@map("pattern_questions")
}

model PatternScoring {
  id             String @id @default(cuid())
  questionId     String
  answer         String
  dimension      String
  dimensionValue String

  @@unique([questionId, answer])
  @@map("pattern_scorings")
}

model PatternProfile {
  id             String @id @default(cuid())
  profileName    String @unique
  nsMatch        String
  relMatch       String
  childhoodMatch String
  profileText    String @db.Text

  @@map("pattern_profiles")
}

model Reel {
  id              String    @id @default(cuid())
  title           String
  creatorName     String
  creatorHandle   String?
  muxAssetId      String
  healingModality String
  profileTags     String[]
  chakraTag       String?
  durationSeconds Int
  isPublished     Boolean   @default(false)
  publishedAt     DateTime?
  approvedBy      String?
  createdAt       DateTime  @default(now())

  @@map("reels")
}

model ContentView {
  id                String   @id @default(cuid())
  userId            String?
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  contentType       String
  contentId         String
  viewedAt          DateTime @default(now())
  completionPercent Float?

  @@map("content_views")
}

model CosmicNote {
  id          String    @id @default(cuid())
  title       String
  body        String    @db.Text
  weekOf      DateTime  @db.Date
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("cosmic_notes")
}

model DailyCheckIn {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date              DateTime  @db.Date
  consciousThoughts String?   @db.Text
  gratitude         String?   @db.Text
  affirmationsDone  Boolean   @default(false)
  routinesDone      Boolean   @default(false)
  habitNote         String?   @db.Text
  beliefNote        String?   @db.Text
  journalNote       String?   @db.Text
  emotions          String[]
  oneChange         String?   @db.Text
  appreciation      String?   @db.Text
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
  @@map("daily_check_ins")
}

model ClientHomework {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  description    String?   @db.Text
  status         String    @default("assigned") // assigned | submitted | reviewed
  assignedAt     DateTime  @default(now())
  dueAt          DateTime?
  submissionText String?   @db.Text
  submissionUrl  String?
  submittedAt    DateTime?
  reviewNote     String?   @db.Text
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, status])
  @@map("client_homework")
}

// ─────────────────────────────────────────────────────────────
// COMMUNITY CIRCLES (Discussions & Feeds)
// ─────────────────────────────────────────────────────────────

model CommunityCircle {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  description   String   @db.Text
  iconUrl       String?
  coverImageUrl String?
  isPrivate     Boolean  @default(false)
  createdAt     DateTime @default(now())

  members CircleMember[]
  posts   CirclePost[]

  @@map("community_circles")
}

model CircleMember {
  id       String          @id @default(cuid())
  userId   String
  circleId String
  joinedAt DateTime        @default(now())
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  circle   CommunityCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@unique([userId, circleId])
  @@map("circle_members")
}

model CirclePost {
  id         String   @id @default(cuid())
  circleId   String
  userId     String
  title      String?
  content    String   @db.Text
  mediaUrls  String[]
  likesCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  circle   CommunityCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments CircleComment[]

  @@index([circleId, createdAt])
  @@map("circle_posts")
}

model CircleComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())

  post CirclePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("circle_comments")
}

// ─────────────────────────────────────────────────────────────
// WEBHOOK IDEMPOTENCY & AUDIT LOG
// ─────────────────────────────────────────────────────────────

model WebhookEventLog {
  id          String   @id @default(cuid())
  gateway     String   // "EASEBUZZ_PRIMARY" | "EASEBUZZ_SECONDARY" | "CASHFREE" | "RAZORPAY"
  eventId     String   @unique // txnid or payment_id or webhook event ID
  eventType   String   // "payment.success" | "payment.failed" | "refund"
  payload     Json
  status      String   @default("PROCESSED") // "PROCESSED" | "FAILED" | "DUPLICATE"
  processedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([gateway, eventId])
  @@map("webhook_event_logs")
}

// ─────────────────────────────────────────────────────────────
// PRE-SESSION ASTROLOGICAL & SOMATIC BRIEFS
// ─────────────────────────────────────────────────────────────

model PreSessionBrief {
  id                    String    @id @default(cuid())
  bookingId             String?   @unique
  orderId               String?
  userId                String
  practitionerName      String    // "Archana Jain" | "Sejal Jain" | "Both"
  serviceType           String
  astrologicalSummary   Json      // Placements, Dasha, Transit insights, Elemental balance, Gemstone remedies
  somaticSummary        Json      // Nervous system tier, Trauma indicators, Polyvagal state, Breath prescription
  clientIntakeSummary   Json      // Intentions, answers, goals
  sessionFocusThemes    String[]
  recommendedRemedies   String[]
  googleCalendarEventId String?
  isDelivered           Boolean   @default(false)
  deliveredAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([practitionerName])
  @@map("pre_session_briefs")
}

